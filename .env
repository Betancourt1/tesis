# ==============================================================================
# ===           Rutas de Archivos para el Proyecto de Tesis              ===
# ==============================================================================
#
# Instrucciones:
# 1. Renombra este archivo a ".env".
# 2. Revisa y ajusta las rutas si tu estructura de directorios es diferente.
#    Por defecto, se asume que el proyecto se ejecuta desde el directorio raíz.
#
# ------------------------------------------------------------------------------
# Directorio de Datos GTFS
# ------------------------------------------------------------------------------
# Ruta al directorio que contiene los archivos GTFS (routes.csv, stops.csv, etc.)
GTFS_DIR=Datasets/gtfs_amg_20240312/Datos

# ------------------------------------------------------------------------------
# Rutas de Salida (Output)
# ------------------------------------------------------------------------------
# Directorio general donde se guardarán los resultados y grafos procesados.
OUTPUT_DIR=grafos

# --- Rutas para L-espacio ---
# Grafo inicial construido desde GTFS (antes de la consolidación)
L_SPACE_INITIAL_GRAPH_PATH=grafos/l_space/grafo_inicial.gexf
# Grafo L-espacio consolidado
L_SPACE_CONSOLIDATED_GRAPH_PATH=grafos/l_space/grafo_consolidado.gpickle
# Carpeta de resultados de robustez para L-espacio
L_SPACE_ROBUSTNESS_OUTPUT_DIR=grafos/l_space/robustez

# --- Rutas para P-espacio ---
# Grafo P-espacio final (construido a partir del L-espacio consolidado)
P_SPACE_GRAPH_PATH=grafos/p_space/grafo_p_space_correcto.gpickle
# Carpeta de resultados de robustez para P-espacio
P_SPACE_ROBUSTNESS_OUTPUT_DIR=grafos/p_space/robustez

# --- Ruta para matrices ---
L_SPACE_DISTANCES_MATRIX_PATH=grafos/l_space
P_SPACE_DISTANCES_MATRIX_PATH=grafos/p_space
